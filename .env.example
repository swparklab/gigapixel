# Copy to .env to override defaults. These values target MAXIMUM ACCURACY and
# assume a high-spec workstation (optimization/throughput is not a concern).

# --- AI / learned feature matching (install requirements-ai.txt first) -------
STITCH_MATCHER=auto                 # auto|loftr|disk_lightglue|sift_lightglue|aliked_lightglue|classic
STITCH_MATCHER_DEVICE=auto          # auto|cuda|cpu
STITCH_MATCHER_INPUT_DIM=2048       # higher = more accurate correspondences
STITCH_MATCHER_MAX_MATCHES=8000
STITCH_MATCHER_MIN_CONFIDENCE=0.2

# --- Registration resolution -------------------------------------------------
STITCH_PLANAR_PREVIEW_MAX_DIM=4000  # classical-detector preview long edge
STITCH_PLANAR_MAX_FEATURES=16000
STITCH_PLANAR_MAX_MATCH_SAMPLES=1200

# --- Robust global bundle adjustment ----------------------------------------
STITCH_PLANAR_ROBUST_REFINE=true
STITCH_PLANAR_ROBUST_ITERATIONS=12
STITCH_PLANAR_HUBER_DELTA=2.5

# --- Focus-robust registration (fixes "breaking" from focus/point mismatch) --
STITCH_FOCUS_NORMALIZE=true           # equalise sharpness before detection
STITCH_PLANAR_LOCAL_ALIGN=true        # optical-flow elastic overlap alignment
STITCH_LOCAL_ALIGN_MAX_DISP=24        # px clamp on local correction

# --- Interactive final-result upscaling --------------------------------------
UPSCALE_BACKEND=auto                  # auto|comfyui|diffusers|realesrgan|classical
UPSCALE_MAX_FACTOR=8
# COMFYUI_UPSCALE_WORKFLOW_PATH=C:/wf/upscale.json   # else falls back to outpaint workflow

# --- Gigapixel blending ------------------------------------------------------
STITCH_PLANAR_TILED_MULTIBAND=true
STITCH_PLANAR_MULTIBAND_BANDS=6
STITCH_PLANAR_MULTIBAND_MAX_PIXELS=400000000   # use in-memory multiband up to this size
STITCH_PLANAR_TILE_PIXELS=120000000
STITCH_PLANAR_TILE_OVERLAP=768

# --- Lens distortion correction (optional; provide YOUR lens coefficients) ---
# Disabled by default: a wrong model hurts more than it helps. Tune k1 visually,
# or set STITCH_LENS_AUTO=true with lensfunpy installed for EXIF-based lookup.
STITCH_LENS_CORRECTION=false
STITCH_LENS_AUTO=false
STITCH_LENS_K1=0.0
STITCH_LENS_K2=0.0
STITCH_LENS_FOCAL_RATIO=1.0

# --- Quality control + automatic repair -------------------------------------
STITCH_QUALITY_CHECK=true
STITCH_QUALITY_MAX_DIM=8000          # higher = finer defect detection
STITCH_AUTO_REPAIR=true
STITCH_REPAIR_BACKEND=auto           # auto|classical|lama|none (lama = simple-lama-inpainting)
STITCH_REPAIR_MAX_HOLE_FRACTION=0.25

# --- Deep retrieval overlap graph (robust matching of unordered sets) --------
STITCH_PAIR_SELECTION=auto           # auto|exhaustive|neighbor|retrieval
STITCH_RETRIEVAL_MODEL=auto          # auto|dinov2|classical (dinov2 needs transformers)
STITCH_RETRIEVAL_TOP_K=8

# --- Learned no-reference quality (QC) --------------------------------------
STITCH_QUALITY_IQA=true
STITCH_QUALITY_IQA_BACKEND=auto      # auto|pyiqa|classical (pyiqa = learned CLIP-IQA)

# --- SAM smart annotation ----------------------------------------------------
SAM_ENABLED=true
SAM_BACKEND=auto                     # auto|sam|classical (classical = GrabCut, no weights)
# SAM_CHECKPOINT=C:/models/sam_vit_h.pth
# SAM_MODEL_TYPE=vit_h

# --- AI output enhancement (generative; OFF by default) ----------------------
STITCH_ENHANCE=false
STITCH_ENHANCE_BACKEND=auto          # auto|realesrgan|classical
STITCH_ENHANCE_SCALE=2

# --- Archival science: colour, scale, provenance, manifest, IIIF -------------
COLOR_MANAGEMENT=true                # ColorChecker CCM + dE2000; gray-world fallback
COLOR_CONFORMANCE_TARGET=fadgi       # fadgi|metamorfoze
SCALE_CALIBRATION=true
SCALE_MARKER_DICT=DICT_4X4_50
SCALE_MARKER_LENGTH_MM=0             # set to your fiducial marker side length (mm)
FOCUS_STACK_METHOD=laplacian         # laplacian|wavelet
PROVENANCE_MAPS=true                 # coverage/synthetic/uncertainty layers
PROCESSING_MANIFEST=true             # SHA-256 fixity + parameters + versions
EMBED_METADATA=true                  # Dublin Core sidecar
IIIF_ENABLED=true
# IIIF_BASE_URL=https://your.host    # external base URL for IIIF ids (else relative)
IIIF_MAX_SIZE=4096                   # max long edge a single IIIF image request returns

# --- Agent platform: condition AI, restore, image-to-3D ----------------------
CONDITION_BACKEND=auto               # auto|deep|classical
CONDITION_CRACK_SENSITIVITY=0.5      # 0..1
CONDITION_DISCOLOR_SENSITIVITY=0.5
RESTORE_BACKEND=auto                 # auto|deep|classical
RESTORE_DECOLOR=true
RESTORE_DECRACK=true
RESTORE_DENOISE=true
SPLAT_DEPTH_BACKEND=auto             # auto|depth_anything|midas|relief
SPLAT_MAX_POINTS=1500000
SPLAT_FORMAT=both                    # pointcloud|gaussian|both
TO3D_DEFAULT_REPRESENTATION=splat    # splat|pointcloud|gaussian|mesh|depth|normals|all
TO3D_BACKEND=depth                   # depth|trellis|hunyuan3d|auto  (deep image-to-3D object gen)
TO3D_MESH_MAX_DIM=1400               # relief-mesh grid resolution cap

# --- Platform operations -----------------------------------------------------
JOB_LEASE_SECONDS=600                # a claimed job is "stale" past this
JOB_HEARTBEAT_SECONDS=15
JOB_MAX_ATTEMPTS=3
JOB_STALE_RECOVERY=true
RECON_BACKEND=auto                   # auto|colmap_gsplat|multiview_depth
SEMANTIC_BACKEND=auto                # auto|clip|classical
COVERAGE_MIN_OVERLAP_INLIERS=30
STREAMING_COMPOSITOR=true            # disk-backed canvas for very large outputs
STREAMING_THRESHOLD_PIXELS=800000000
# API_KEY=change-me                  # when set, /api requires X-API-Key header

# --- Generative outpainting (non-archival; OFF by default) -------------------
OUTPAINT_BACKEND=auto                # auto|comfyui|diffusers|classical
OUTPAINT_DEFAULT_MODE=fill_borders   # fill_borders|extend
OUTPAINT_MARGIN_PX=256
STITCH_OUTPAINT_FILL=false           # auto-fill rotated-mosaic borders in the pipeline
# COMFYUI_URL=http://127.0.0.1:8188  # ComfyUI server for the Flux Fill workflow
# COMFYUI_WORKFLOW_PATH=C:/wf/outpaint.json  # exported ComfyUI workflow (API format)

# --- Output ------------------------------------------------------------------
OPTIMIZED_JPEG_QUALITY=95
RAW_BIGTIFF_COMPRESSION=none
RAW_BIGTIFF_TILED=true
RAW_BIGTIFF_TILE_SIZE=512
LOG_LEVEL=INFO
LOG_FORMAT=json
